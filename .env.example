# ==============================================================================
# Model and Cloud Authentication
# ==============================================================================
# Option 1: Vertex AI (Recommended for Agent Runtime)
MODEL_NAME=gemini-2.5-flash
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=europe-west2

# Option 2: Gemini API Key (Direct API access)
# GOOGLE_API_KEY=your-gemini-api-key

# ==============================================================================
# OpenTelemetry Tracing / Generative AI Instrumentation
# ==============================================================================
# Enable built-in OpenTelemetry telemetry export to Cloud Trace & Cloud Logging
GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=true
# Enable OpenTelemetry semantic conventions for Generative AI
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
# Ensure the full message content (prompts & responses) is captured in the trace events
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=EVENT_ONLY

# ==============================================================================
# OpenFDA Configuration (Optional)
# ==============================================================================
# Public openFDA rate limit is 240 requests/min. Adding an API key increases to 1000 requests/min.
# OPENFDA_API_KEY=your-openfda-api-key

# ==============================================================================
# Google Cloud Model Armor / Sensitive Data Protection (DLP)
# ==============================================================================
# Template ID configured via Terraform (defaults to local fallback if omitted)
MODEL_ARMOR_TEMPLATE_ID=fda-patient-agent-model-armor


